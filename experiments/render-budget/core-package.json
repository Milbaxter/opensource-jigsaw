    "./lod": {
      "types": "./dist/lod.d.ts",
      "import": "./dist/lod.js"
    },
    "./progressive-glb": {
      "types": "./dist/progressive-glb.d.ts",
      "import": "./dist/progressive-glb.js"
    },
    "./multi-view-phash": {
      "types": "./dist/multi-view-phash.d.ts",
