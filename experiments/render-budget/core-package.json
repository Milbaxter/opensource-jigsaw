{
  "name": "@spatialpack/core",
  "version": "0.1.0",
  "description": "Standards-first glTF/GLB/USDZ engine — analyze, optimize (KTX2/meshopt/WebP/AVIF), recipe search, commerce-readiness scoring + autocorrect, USDZ validation, USDA/USDC, Gaussian splats. Pure TypeScript.",
  "author": "Michael Montalbano",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/montabano1/SpatialPack.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/montabano1/SpatialPack/tree/main/packages/core#readme",
  "keywords": [
